:root {
    --obsidian: #0a0a0a;
    --black: #121212;
    --charcoal: #1a1a1a;
    --orange: #ff6b00;
    --orange-light: #ff8533;
    --gold: #ffd700;
    --gold-dim: #b8860b;
    --agro-green: #39ff14;
    --agro-dark: #1b5e20;
    --tech-purple: #8b5cf6;
    --tech-blue: #00d4ff;
    --alert-red: #ff0040;
    --alert-yellow: #ffaa00;
    --text: #ffffff;
    --text-dim: #a0a0a0;
    --card-bg: rgba(255, 255, 255, 0.03);
    --border: rgba(255, 255, 255, 0.1);
    --shadow: 0 4px 20px rgba(0, 0, 0, 0.8);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
}

body {
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    background: var(--obsidian);
    color: var(--text);
    overflow-x: hidden;
    line-height: 1.6;
}

/* Tipografía disruptiva */
h1, h2, h3 {
    font-weight: 800;
    letter-spacing: -0.02em;
    text-transform: uppercase;
}

.brand-text {
    background: linear-gradient(135deg, var(--orange), var(--gold), var(--agro-green));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-shadow: 0 0 30px rgba(255, 107, 0, 0.3);
}

/* Layout Principal */
.app-container {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

/* Header */
.header {
    background: linear-gradient(180deg, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.7) 100%);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
    padding: 1rem;
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: var(--shadow);
}

.header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
}

.logo {
    font-size: 1.5rem;
    font-weight: 900;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.logo-icon {
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, var(--orange), var(--gold));
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    box-shadow: 0 0 20px rgba(255, 107, 0, 0.4);
}

.subtitle {
    font-size: 0.75rem;
    color: var(--text-dim);
    font-style: italic;
    margin-top: 0.25rem;
}

/* Selector de Perfil */
.profile-selector {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding: 0.5rem 0;
    scrollbar-width: none;
}

.profile-selector::-webkit-scrollbar {
    display: none;
}

.profile-btn {
    flex-shrink: 0;
    padding: 0.75rem 1.5rem;
    border: 1px solid var(--border);
    background: var(--card-bg);
    color: var(--text-dim);
    border-radius: 50px;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.3s;
    white-space: nowrap;
}

.profile-btn.active {
    background: linear-gradient(135deg, var(--orange), var(--gold));
    color: var(--black);
    border-color: transparent;
    box-shadow: 0 0 20px rgba(255, 107, 0, 0.3);
}

.profile-btn[data-profile="ramon"].active {
    background: linear-gradient(135deg, #5d4037, #8d6e63);
    color: white;
}

.profile-btn[data-profile="marta"].active {
    background: linear-gradient(135deg, var(--tech-purple), var(--tech-blue));
    color: white;
}

.profile-btn[data-profile="futuro"].active {
    background: linear-gradient(135deg, var(--agro-green), var(--tech-blue));
    color: var(--black);
}

/* Navegación */
.nav-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
    padding: 0.5rem;
    background: var(--black);
    border-top: 1px solid var(--border);
    position: fixed;
    bottom: 0;
    width: 100%;
    z-index: 1000;
}

.nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.5rem;
    background: none;
    border: none;
    color: var(--text-dim);
    font-size: 0.7rem;
    cursor: pointer;
    transition: all 0.3s;
    gap: 0.25rem;
}

.nav-item.active {
    color: var(--orange);
    transform: translateY(-5px);
}

.nav-item-icon {
    font-size: 1.5rem;
    filter: drop-shadow(0 0 10px rgba(255, 107, 0, 0.3));
}

/* Contenido Principal */
.main-content {
    flex: 1;
    padding: 1rem;
    padding-bottom: 100px;
    overflow-y: auto;
}

.section {
    display: none;
    animation: fadeIn 0.4s;
}

.section.active {
    display: block;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
}

/* Dashboard - Tarjetas */
.dashboard-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
}

.card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 1.5rem;
    position: relative;
    overflow: hidden;
    transition: transform 0.3s, box-shadow 0.3s;
    cursor: pointer;
}

.card:active {
    transform: scale(0.98);
}

.card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--orange), var(--gold));
    opacity: 0.5;
}

.card.alert {
    border-color: var(--alert-red);
    box-shadow: 0 0 20px rgba(255, 0, 64, 0.2);
}

.card.warning {
    border-color: var(--alert-yellow);
}

.card.success {
    border-color: var(--agro-green);
}

.card-icon {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
}

.card-value {
    font-size: 1.75rem;
    font-weight: 800;
    margin-bottom: 0.25rem;
}

.card-label {
    font-size: 0.8rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.card-status {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--agro-green);
    box-shadow: 0 0 10px var(--agro-green);
}

.card-status.warning {
    background: var(--alert-yellow);
    box-shadow: 0 0 10px var(--alert-yellow);
}

.card-status.critical {
    background: var(--alert-red);
    box-shadow: 0 0 10px var(--alert-red);
}

/* Semáforo Visual */
.semaphore {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
    padding: 1rem;
    background: rgba(0,0,0,0.3);
    border-radius: 12px;
}

.semaphore-light {
    flex: 1;
    height: 60px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.8rem;
    opacity: 0.3;
    transition: all 0.3s;
}

.semaphore-light.active {
    opacity: 1;
    transform: scale(1.05);
    box-shadow: 0 0 20px currentColor;
}

.semaphore-green {
    background: var(--agro-green);
    color: var(--black);
}

.semaphore-yellow {
    background: var(--alert-yellow);
    color: var(--black);
}

.semaphore-red {
    background: var(--alert-red);
    color: white;
}

/* Botones Principales */
.btn-primary {
    width: 100%;
    padding: 1.25rem;
    background: linear-gradient(135deg, var(--orange), var(--gold));
    color: var(--black);
    border: none;
    border-radius: 16px;
    font-weight: 800;
    font-size: 1.1rem;
    cursor: pointer;
    margin-bottom: 1rem;
    box-shadow: 0 4px 20px rgba(255, 107, 0, 0.3);
    transition: transform 0.2s, box-shadow 0.2s;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.btn-primary:active {
    transform: translateY(2px);
    box-shadow: 0 2px 10px rgba(255, 107, 0, 0.3);
}

.btn-secondary {
    width: 100%;
    padding: 1rem;
    background: var(--card-bg);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 16px;
    font-weight: 600;
    cursor: pointer;
    margin-bottom: 0.5rem;
    transition: all 0.3s;
}

.btn-secondary:hover {
    border-color: var(--orange);
    background: rgba(255, 107, 0, 0.1);
}

/* Modo Ramón - Botones Grandes */
.ramon-mode .card {
    padding: 2rem;
    min-height: 150px;
}

.ramon-mode .card-icon {
    font-size: 3.5rem;
}

.ramon-mode .card-value {
    font-size: 2.5rem;
}

.ramon-mode .btn-primary {
    padding: 2rem;
    font-size: 1.5rem;
}

/* Mapa SVG */
.farm-map {
    width: 100%;
    height: 300px;
    background: var(--charcoal);
    border-radius: 20px;
    position: relative;
    overflow: hidden;
    border: 2px solid var(--border);
}

.map-zone {
    position: absolute;
    border: 2px solid var(--border);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s;
}

.map-zone:hover {
    transform: scale(1.05);
    z-index: 10;
    box-shadow: 0 0 30px rgba(255, 107, 0, 0.3);
}

.zone-crop {
    background: rgba(57, 255, 20, 0.1);
    border-color: var(--agro-green);
    color: var(--agro-green);
}

.zone-livestock {
    background: rgba(255, 107, 0, 0.1);
    border-color: var(--orange);
    color: var(--orange);
}

.zone-water {
    background: rgba(0, 212, 255, 0.1);
    border-color: var(--tech-blue);
    color: var(--tech-blue);
}

/* LOOPHH - Interacciones */
.loophh-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.loophh-node {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    position: relative;
}

.loophh-arrow {
    position: absolute;
    right: -20px;
    font-size: 1.5rem;
    color: var(--orange);
}

.loophh-icon {
    font-size: 2.5rem;
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 107, 0, 0.1);
    border-radius: 12px;
    border: 2px solid var(--orange);
}

.loophh-content h4 {
    color: var(--gold);
    margin-bottom: 0.25rem;
}

.loophh-content p {
    font-size: 0.9rem;
    color: var(--text-dim);
}

/* Lector de Fotos */
.camera-interface {
    background: var(--charcoal);
    border-radius: 20px;
    padding: 2rem;
    text-align: center;
    border: 2px dashed var(--border);
    margin-bottom: 1rem;
    position: relative;
    overflow: hidden;
}

.camera-placeholder {
    font-size: 4rem;
    margin-bottom: 1rem;
    opacity: 0.5;
}

.camera-btn {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--orange);
    border: 4px solid white;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    cursor: pointer;
    box-shadow: 0 0 30px rgba(255, 107, 0, 0.5);
    transition: transform 0.2s;
}

.camera-btn:active {
    transform: scale(0.9);
}

.analysis-result {
    background: rgba(0, 0, 0, 0.5);
    border-radius: 16px;
    padding: 1.5rem;
    margin-top: 1rem;
    border-left: 4px solid var(--tech-purple);
}

.confidence-bar {
    height: 8px;
    background: var(--charcoal);
    border-radius: 4px;
    margin: 1rem 0;
    overflow: hidden;
}

.confidence-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--alert-red), var(--alert-yellow), var(--agro-green));
    border-radius: 4px;
    transition: width 1s;
}

/* Calculadora de Unidades */
.unit-converter {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: center;
    margin-bottom: 1rem;
}

.unit-input {
    background: var(--card-bg);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 1rem;
    border-radius: 12px;
    font-size: 1.2rem;
    font-weight: 700;
    text-align: center;
}

.unit-label {
    text-align: center;
    color: var(--text-dim);
    font-size: 0.9rem;
    text-transform: uppercase;
}

.conversion-result {
    background: linear-gradient(135deg, rgba(255, 107, 0, 0.1), rgba(255, 215, 0, 0.1));
    border: 1px solid var(--gold-dim);
    border-radius: 12px;
    padding: 1rem;
    text-align: center;
    margin-top: 1rem;
    font-size: 1.1rem;
}

.conversion-result strong {
    color: var(--gold);
    display: block;
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
}

/* Simulador "¿Y si...?" */
.scenario-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
    margin-bottom: 1rem;
    cursor: pointer;
    transition: all 0.3s;
}

.scenario-card:hover {
    border-color: var(--tech-purple);
    transform: translateX(5px);
}

.scenario-title {
    color: var(--tech-blue);
    font-weight: 700;
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.scenario-impact {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
    font-size: 0.9rem;
}

.impact-item {
    display: flex;
    align-items: center;
    gap: 0.25rem;
}

.impact-positive { color: var(--agro-green); }
.impact-negative { color: var(--alert-red); }
.impact-neutral { color: var(--text-dim); }

/* Modo Futuro Finquero - Gamificación */
.quest-card {
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.1), rgba(0, 212, 255, 0.1));
    border: 1px solid var(--tech-purple);
    border-radius: 20px;
    padding: 1.5rem;
    margin-bottom: 1rem;
    position: relative;
    overflow: hidden;
}

.quest-card::before {
    content: '🎯 RETO';
    position: absolute;
    top: 1rem;
    right: -2rem;
    background: var(--tech-purple);
    color: white;
    padding: 0.25rem 3rem;
    transform: rotate(45deg);
    font-size: 0.7rem;
    font-weight: 800;
}

.quest-points {
    display: inline-block;
    background: var(--gold);
    color: var(--black);
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-weight: 800;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
}

/* Economía */
.economy-dashboard {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-bottom: 1.5rem;
}

.economy-item {
    background: var(--card-bg);
    border-radius: 12px;
    padding: 1rem;
    text-align: center;
}

.economy-label {
    font-size: 0.8rem;
    color: var(--text-dim);
    margin-bottom: 0.5rem;
}

.economy-value {
    font-size: 1.25rem;
    font-weight: 700;
}

.economy-value.positive { color: var(--agro-green); }
.economy-value.negative { color: var(--alert-red); }

/* Decisiones */
.decision-matrix {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.decision-option {
    background: var(--card-bg);
    border: 2px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
    cursor: pointer;
    transition: all 0.3s;
    position: relative;
}

.decision-option:hover {
    border-color: var(--orange);
    background: rgba(255, 107, 0, 0.05);
}

.decision-option.selected {
    border-color: var(--agro-green);
    background: rgba(57, 255, 20, 0.05);
}

.decision-option.selected::after {
    content: '✓ SELECCIONADO';
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: var(--agro-green);
    color: var(--black);
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.7rem;
    font-weight: 800;
}

.decision-title {
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--gold);
}

.decision-stats {
    display: flex;
    gap: 1rem;
    font-size: 0.9rem;
    color: var(--text-dim);
}

/* Utilidades */
.badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
}

.badge-measured { background: var(--agro-green); color: var(--black); }
.badge-estimated { background: var(--alert-yellow); color: var(--black); }
.badge-inferred { background: var(--tech-blue); color: var(--black); }
.badge-pending { background: var(--alert-red); color: white; }

.modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0,0,0,0.9);
    z-index: 2000;
    padding: 2rem;
    overflow-y: auto;
}

.modal.active {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.modal-content {
    background: var(--charcoal);
    border: 1px solid var(--border);
    border-radius: 24px;
    padding: 2rem;
    max-width: 500px;
    width: 100%;
    position: relative;
}

.modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: none;
    border: none;
    color: var(--text-dim);
    font-size: 1.5rem;
    cursor: pointer;
}

/* Responsive */
@media (min-width: 768px) {
    .dashboard-grid {
        grid-template-columns: repeat(4, 1fr);
    }
    
    .nav-grid {
        grid-template-columns: repeat(8, 1fr);
    }
}

/* Animaciones */
@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
}

.pulse {
    animation: pulse 2s infinite;
}

.glow-text {
    text-shadow: 0 0 10px currentColor;
}

/* Scrollbar personalizada */
::-webkit-scrollbar {
    width: 8px;
    height: 8px;
}

::-webkit-scrollbar-track {
    background: var(--obsidian);
}

::-webkit-scrollbar-thumb {
    background: var(--charcoal);
    border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
    background: var(--orange);
  }
